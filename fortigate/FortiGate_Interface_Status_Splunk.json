{
  "visualizations": {
    "viz_current_status": {
      "type": "splunk.table",
      "dataSources": {
        "primary": "ds_current_status"
      },
      "title": "Current Interface Status (Latest State)"
    },
    "viz_status_timeline": {
      "type": "splunk.line",
      "dataSources": {
        "primary": "ds_timeline"
      },
      "title": "Interface Status Changes Over Time"
    },
    "viz_flap_count": {
      "type": "splunk.column",
      "dataSources": {
        "primary": "ds_flap_count"
      },
      "title": "Interface Flap Count (Up/Down Events)"
    },
    "viz_events_table": {
      "type": "splunk.table",
      "dataSources": {
        "primary": "ds_events_table"
      },
      "title": "Recent Interface Events"
    },
    "viz_1lWcA8up": {
      "type": "splunk.image",
      "options": {
        "src": "splunk-enterprise-kvstore://6a6b02a2078078323706fafe"
      },
      "cornerRadius": [
        1,
        0,
        0,
        0
      ]
    }
  },
  "dataSources": {
    "ds_current_status": {
      "type": "ds.search",
      "options": {
        "query": "index=* sourcetype=fortigate_event logdesc=\"Interface status changed\" | rex field=msg \"Interface (?<interface>\\S+) was turned (?<state>\\w+)\" | sort -_time | dedup interface | table interface status _time",
        "queryParameters": {
          "earliest": "-30d",
          "latest": "now"
        }
      },
      "name": "Current Status"
    },
    "ds_timeline": {
      "type": "ds.search",
      "options": {
        "query": "index=* sourcetype=fortigate_event logdesc=\"Interface status changed\" | rex field=msg \"Interface (?<interface>\\S+) was turned (?<state>\\w+)\" | timechart count by interface",
        "queryParameters": {
          "earliest": "-30d",
          "latest": "now"
        }
      },
      "name": "Status Timeline"
    },
    "ds_flap_count": {
      "type": "ds.search",
      "options": {
        "query": "index=* sourcetype=fortigate_event logdesc=\"Interface status changed\" | rex field=msg \"Interface (?<interface>\\S+) was turned (?<state>\\w+)\" | stats count by interface",
        "queryParameters": {
          "earliest": "-30d",
          "latest": "now"
        }
      },
      "name": "Flap Count"
    },
    "ds_events_table": {
      "type": "ds.search",
      "options": {
        "query": "index=* sourcetype=fortigate_event logdesc=\"Interface status changed\" | rex field=msg \"Interface (?<interface>\\S+) was turned (?<state>\\w+)\" | table _time interface status msg | sort -_time",
        "queryParameters": {
          "earliest": "-30d",
          "latest": "now"
        }
      },
      "name": "Events Table"
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "latest": "now",
            "earliest": "-30d"
          }
        }
      }
    }
  },
  "inputs": {
    "input_l4VZgA2T": {
      "options": {
        "defaultValue": "-24h@h,now",
        "token": "tr_saH26jXv"
      },
      "title": "Time Range Input Title",
      "type": "input.timerange"
    }
  },
